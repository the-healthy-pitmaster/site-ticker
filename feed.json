    {
      "platform": "tilvids",
      "platformLabel": "TILvids",
      "handle": "@therealjimbbq",
      "profileUrl": "https://tilvids.com/a/therealjimbbq/video-channels",
      "displayName": "The Healthy Pitmaster",
      "id": "til-hWNfMHd45zxLCmXLpRSH95",
      "publishedAt": "2026-10-06T16:06:23.995000-06:00",
      "text": "A stem cell treatment took a person with type 1 diabetes from daily insulin shots to no insulin in 75 days. Type 1 is different from what I had. In type 1 the body attacks the cells that make insulin, so real food and\u2026",
      "url": "https://tilvids.com/videos/watch/8938e345-4f39-4333-a5ed-84fb939c3258",
      "source": "tilvids"
    },
    {
      "platform": "tilvids",
      "platformLabel": "TILvids",
      "handle": "@therealjimbbq",
      "profileUrl": "https://tilvids.com/a/therealjimbbq/video-channels",
      "displayName": "The Healthy Pitmaster",
      "id": "til-nuLgZMVBcvgpSk5rEq8QwG",
      "publishedAt": "2026-10-06T07:13:02.599000-06:00",
      "text": "Your brain runs on insulin too. It helps brain cells take in fuel and keep their connections healthy. When your cells stop listening to insulin, the problem doesn't stay in your blood sugar. Research has tied insulin\u2026",
      "url": "https://tilvids.com/videos/watch/ae1405fa-56b3-4abf-93d0-8696fd03b54c",
      "source": "tilvids"
    },
    {
